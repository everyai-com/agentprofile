{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentprofile",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // One Durable Object per user profile — the source of truth for that profile's
  // skills, memory, and (Phase 3) credentials. Uses DO-embedded SQLite.
  "durable_objects": {
    "bindings": [
      { "name": "PROFILE", "class_name": "ProfileDO" },
      { "name": "OAUTH", "class_name": "OAuthDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProfileDO"] },
    { "tag": "v2", "new_sqlite_classes": ["OAuthDO"] }
  ],

  // Skill bundles will live in R2 (content-addressed). Left unbound for the first
  // deploy — the worker degrades gracefully (skills store inline in DO SQLite) and
  // R2 is only needed for large bundles. To enable:
  //   npx wrangler r2 bucket create agentprofile-bundles
  // then uncomment:
  // "r2_buckets": [{ "binding": "BUNDLES", "bucket_name": "agentprofile-bundles" }],

  // Workers AI powers semantic recall (fact + query embeddings). If the binding
  // or model is unavailable, recall degrades gracefully to keyword search.
  "ai": { "binding": "AI" },

  // PUBLIC_BASE_URL empty => the worker uses the request origin, so it self-describes
  // correctly on workers.dev, a custom domain, or localhost with no reconfiguration.
  "vars": {
    "MODE": "cloud",
    "PUBLIC_BASE_URL": ""
  }
}
